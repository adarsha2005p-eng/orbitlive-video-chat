# In development with local Vite proxy: leave blank
# In production on Vercel: set to your deployed backend HTTPS URL (e.g. Render / Koyeb)
VITE_API_URL="https://your-orbitlive-backend.onrender.com"
VITE_SOCKET_URL="https://your-orbitlive-backend.onrender.com"
