# ==========================================
# OrbitLive Server Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-orbitlive.vercel.app

# Database (PostgreSQL via Neon / Supabase / Render)
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Redis Queue (Upstash Redis with TLS rediss:// protocol)
REDIS_URL="rediss://default:password@us1-humble-mammal-12345.upstash.io:6379"

# Security
JWT_SECRET="your-ultra-secure-random-jwt-secret-key-at-least-32-chars-long"

# STUN / TURN
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_SERVERS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
