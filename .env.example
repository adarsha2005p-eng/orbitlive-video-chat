# ==========================================
# OrbitLive Video Chat Environment Variables
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
# In production, set to your Vercel URL (e.g. https://your-orbitlive.vercel.app). Supports comma-separated origins.
CLIENT_URL=https://your-orbitlive.vercel.app

# 2. Database (PostgreSQL with Prisma)
# Free-Tier Provider: Neon (https://neon.tech)
# Neon connection strings (pooled) typically look like:
# postgresql://neondb_owner:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://orbit:orbitpassword@localhost:5432/orbitlive?schema=public"

# 3. Redis Matchmaking Queue & State
# Free-Tier Provider: Upstash Redis (https://upstash.com)
# Upstash TLS connection strings typically look like:
# rediss://default:password@us1-humble-mammal-12345.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# 4. Authentication Security
# Generate a random 32+ character string (e.g. run: openssl rand -hex 32)
JWT_SECRET="your-ultra-secure-random-jwt-secret-key-at-least-32-chars-long"

# 5. WebRTC STUN / TURN Configuration
# Public Google STUN servers work out of the box for worldwide P2P
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Optional: Add free-tier TURN credentials (e.g. from Metered.ca / Twilio / Coturn) for symmetric NAT traversal
TURN_SERVERS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
